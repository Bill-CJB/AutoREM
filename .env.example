# Set these variables in your shell. This file is not loaded automatically.
AUTOREM_API_KEY=YOUR_API_KEY
AUTOREM_CODER_API_KEY=YOUR_CODER_API_KEY
AUTOREM_MODEL=deepseek-v4-flash
AUTOREM_CODER_MODEL=deepseek-v4-pro

# Optional endpoint overrides; defaults depend on the task (see README).
# AUTOREM_BASE_URL=https://your-provider.example/v1
# AUTOREM_CODER_BASE_URL=https://your-provider.example/v1

# Optional API field overrides; unset variables preserve final role settings.
# An empty ENABLE_THINKING, REASONING_EFFORT, or MAX_TOKENS value omits that API field.
# AUTOREM_ENABLE_THINKING=true
# AUTOREM_REASONING_EFFORT=high
# AUTOREM_MAX_TOKENS=32768
# AUTOREM_JSON_MODE=true
# AUTOREM_TIMEOUT=600
# The same suffixes with AUTOREM_CODER_ apply only to the coder.
